# Dart tooling (dart_scoring_core, and anything outside app/ which has
# its own Flutter-generated .gitignore files per platform folder).
.dart_tool/
.packages
build/

# Packages (as opposed to apps) conventionally don't commit their lockfile.
packages/dart_scoring_core/pubspec.lock

# Regenerated by `flutter pub get`; can contain machine-specific absolute
# paths, so it shouldn't be committed even though app/.gitignore (as
# generated by `flutter create`) doesn't list it.
app/.flutter-plugins
app/.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
